{
  "name": "@maelstrom-futurism/core",
  "version": "0.7.0",
  "description": "OSMstudios own React component library",
  "author": "Dawson Goodell <dawsong@osmstudios.com>",
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "tooling/*",
      "website"
    ],
    "nohoist": [
      "@emotion/react/types",
      "**/@emotion/react/types",
      "**/@types/theme-ui",
      "**/@types/theme-ui/**",
      "**/@types/theme-ui__components"
    ]
  },
  "files": [
    "dist"
  ],
  "repository": "https://github.com/DawsonG/maelstrom-futurism",
  "license": "MIT",
  "scripts": {
    "build": "lerna run build --ignore src --no-private --stream",
    "test": "jest",
    "prepublishOnly": "npm run build",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook"
  },
  "devDependencies": {
    "@babel/cli": "^7.14.8",
    "@babel/core": "^7.14.8",
    "@babel/plugin-proposal-class-properties": "^7.14.5",
    "@babel/preset-env": "^7.14.9",
    "@babel/preset-react": "^7.14.5",
    "@babel/preset-typescript": "^7.14.5",
    "@emotion/babel-plugin": "^11.3.0",
    "@emotion/react": "^11.1.4",
    "cross-env": "^7.0.3",
    "lerna": "^4.0.0",
    "react": "^17.0.2",
    "rimraf": "^3.0.2",
    "typescript": "^4.3.5"
  },
  "peerDependencies": {
    "@emotion/react": "^11.1.4",
    "react": ">=17.0.0"
  }
}
