{
  "name": "maelstrom-futurism",
  "version": "0.4.0a",
  "description": "OSMstudios own React component library",
  "author": "Dawson Goodell <dawsong@osmstudios.com>",
  "main": "dist/main.bundle.js",
  "module": "dist/plugin.es.js",
  "typings": "dist/index.d.ts",
  "unpkg": "dist/plugin.umd.js",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "storybook": "start-storybook -p 5006 --ci",
    "build-storybook": "npm run build && rimraf storybook-static && build-storybook",
    "build": "webpack --mode=production",
    "build:watch": "chokidar 'src/**/*.ts' 'src/**/*.tsx' -c 'npm run build'",
    "test:cover": "npm run test && codecov",
    "test": "jest",
    "dev:docz": "docz dev",
    "build:docz": "docz build",
    "prepublishOnly": "npm run test && npm run build",
    "prepare": "webpack --mode=production",
    "test:watch": "npm test -- --watchAll",
    "precommit": "pretty-quick --staged",
    "format": "pretty-quick",
    "now-build": "npm run build-storybook",
    "now-start": "cd storybook-static && serve",
    "deploy": "npm run now-build && cd storybook-static && now"
  },
  "devDependencies": {
    "@babel/core": "^7.1.5",
    "@babel/plugin-proposal-object-rest-spread": "^7.0.0",
    "@babel/preset-env": "^7.1.5",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-typescript": "^7.1.0",
    "@types/enzyme": "^3.1.15",
    "@types/jest": "^24.0.12",
    "@types/react-test-renderer": "^16.0.2",
    "@types/sinon": "^7.0.11",
    "@types/storybook__react": "^4.0.0",
    "awesome-typescript-loader": "^5.2.1",
    "babel-core": "^7.0.0-0",
    "babel-jest": "^24.8.0",
    "babel-loader": "^8.0.4",
    "babel-plugin-require-context-hook": "^1.0.0",
    "babel-plugin-transform-es2015-modules-commonjs": "^6.26.2",
    "chokidar": "^3.0.0",
    "clean-webpack-plugin": "^3.0.0",
    "codecov": "^3.1.0",
    "docz": "^1.2.0",
    "enzyme": "^3.6.0",
    "enzyme-adapter-react-16": "^1.7.0",
    "husky": "^2.2.0",
    "jest": "^24.8.0",
    "jest-emotion": "^10.0.11",
    "moment": "^2.24.0",
    "prettier": "^1.15.2",
    "pretty-quick": "^1.6.0",
    "react-test-renderer": "^16.6.1",
    "serve": "^11.0.0",
    "sinon": "^7.1.1",
    "ts-jest": "^24.0.2",
    "typescript": "3.4.5",
    "webpack": "^4.25.1",
    "webpack-cli": "^3.3.11",
    "webpack-node-externals": "^1.7.2"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/__setup__/setup.ts"
    ],
    "setupTestFrameworkScriptFile": "<rootDir>/tests/__setup__/setupFramework.ts",
    "transform": {
      ".[jt]sx?$": "<rootDir>/node_modules/babel-jest"
    },
    "testRegex": "(<rootDir>/(tests|src)/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "moduleNameMapper": {
      "@src/(.*)": "<rootDir>/src/$1",
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/tests/__mocks__/fileMock.js"
    },
    "collectCoverage": true,
    "coverageDirectory": "<rootDir>/coverage"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "dependencies": {
    "@emotion/babel-preset-css-prop": "^10.0.7",
    "@emotion/styled": "^10.0.14",
    "@storybook/addon-a11y": "^5.3.17",
    "@storybook/addon-actions": "^5.3.17",
    "@storybook/addon-backgrounds": "^5.3.17",
    "@storybook/addon-centered": "^5.3.17",
    "@storybook/addon-console": "^1.2.1",
    "@storybook/addon-info": "^5.3.17",
    "@storybook/addon-knobs": "^5.3.17",
    "@storybook/addon-links": "^5.3.17",
    "@storybook/addon-options": "^5.3.17",
    "@storybook/addon-storysource": "^5.3.17",
    "@storybook/addon-viewport": "^5.3.17",
    "@storybook/addons": "^5.3.17",
    "@storybook/react": "^5.3.17",
    "emotion": "^10.0.9",
    "fast-deep-equal": "^2.0.1",
    "immutable": "^4.0.0-rc.12",
    "polished": "^3.3.2",
    "prop-types": "^15.6.2",
    "react": "^16.13.0",
    "react-icons-kit": "^1.2.1",
    "scroll-data-hook": "^1.0.1",
    "storybook": "^5.3.17"
  }
}
