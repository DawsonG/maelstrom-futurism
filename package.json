{
  "name": "@maelstrom-futurism/core",
  "version": "0.7.0",
  "description": "OSMstudios own React component library",
  "author": "Dawson Goodell <dawsong@osmstudios.com>",
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "tooling/*",
      "website"
    ],
    "nohoist": [
      "@emotion/react/types",
      "**/@emotion/react/types",
      "**/@types/theme-ui",
      "**/@types/theme-ui/**",
      "**/@types/theme-ui__components",
      "vite"
    ]
  },
  "files": [
    "dist"
  ],
  "repository": "https://github.com/DawsonG/maelstrom-futurism",
  "license": "MIT",
  "scripts": {
    "build": "lerna run build --ignore src,website --no-private --stream",
    "test": "lerna run test --ignore src,website --no-private --stream",
    "clean": "lerna run clean --ignore src,website --no-private --stream && rm -Rf node_modules && rm package-lock.json",
    "bootstrap": "lerna bootstrap",
    "prepublishOnly": "npm run build",
    "create-documentation-website": "cd ./website && npm run build",
    "create-package": "node ./bin/createPackage.js"
  },
  "devDependencies": {
    "@testing-library/react": "^13.4.0",
    "@vitest/coverage-v8": "^2.1.8",
    "cross-env": "^7.0.3",
    "lerna": "^8.1.8",
    "typescript": "^5.8.2",
    "vitest": "^2.1.8",
    "polished": "^4.3.1"
  }
}
