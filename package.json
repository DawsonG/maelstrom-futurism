{
  "name": "maelstrom-futurism-root",
  "version": "0.11.0",
  "private": true,
  "description": "OSMstudios own React component library",
  "author": "Dawson Goodell <dawsong@osmstudios.com>",
  "type": "module",
  "workspaces": [
    "packages/*",
    "website"
  ],
  "files": [
    "dist"
  ],
  "repository": "https://github.com/DawsonG/maelstrom-futurism",
  "license": "MIT",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "npm run clean --workspaces --if-present && rm -Rf node_modules && rm package-lock.json",
    "prepublishOnly": "npm run build",
    "create-documentation-website": "cd ./website && npm run build",
    "publish": "node ./bin/cli.js -- publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@svgr/plugin-svgo": "^8.1.0",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "commander": "^14.0.2",
    "cross-env": "^10.1.0",
    "polished": "^4.3.1",
    "terser": "^5.44.1",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-plugin-sass-dts": "^1.3.34",
    "vite-plugin-static-copy": "^3.1.4",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": ">= 18",
    "react-dom": ">= 18"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0"
  }
}
