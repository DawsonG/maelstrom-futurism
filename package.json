{
  "name": "maelstrom-futurism",
  "version": "0.6.0",
  "description": "OSMstudios own React component library",
  "author": "Dawson Goodell <dawsong@osmstudios.com>",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "typings": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": "https://github.com/DawsonG/maelstrom-futurism",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "concurrently npm:build:*",
    "build:esm": "babel src --extensions .ts,.tsx -d dist/esm --source-maps --copy-files --no-copy-ignored",
    "build:cjs": "babel src --extensions .ts,.tsx -d dist/cjs --source-maps --copy-files --no-copy-ignored",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationDir dist/types",
    "test": "jest",
    "prepublishOnly": "npm run build",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook"
  },
  "devDependencies": {
    "@babel/cli": "^7.14.8",
    "@babel/core": "^7.14.8",
    "@babel/plugin-syntax-jsx": "^7.14.5",
    "@babel/plugin-transform-react-display-name": "^7.14.5",
    "@babel/plugin-transform-react-jsx": "^7.14.9",
    "@babel/plugin-transform-react-jsx-development": "^7.14.5",
    "@babel/plugin-transform-react-pure-annotations": "^7.14.5",
    "@babel/plugin-transform-typescript": "^7.14.6",
    "@babel/preset-env": "^7.14.9",
    "@babel/preset-react": "^7.14.5",
    "@babel/preset-typescript": "^7.14.5",
    "@storybook/addon-actions": "^6.3.6",
    "@storybook/addon-essentials": "^6.3.6",
    "@storybook/addon-links": "^6.3.6",
    "@storybook/react": "^6.3.6",
    "@types/react-dom": "^17.0.9",
    "babel-loader": "^8.2.2",
    "clean-webpack-plugin": "^4.0.0-alpha.0",
    "concurrently": "^6.2.0",
    "husky": "^2.2.0",
    "prettier": "^1.15.2",
    "rimraf": "^3.0.2",
    "ts-node": "^10.1.0",
    "typescript": "^4.0.2"
  },
  "dependencies": {
    "@emotion/babel-plugin": "^11.3.0",
    "@emotion/react": "^11.4.0",
    "immutability-helper": "^3.1.1",
    "lodash": "^4.17.15",
    "polished": "^3.6.6",
    "react-contenteditable": "^3.3.5",
    "react-dnd": "^11.1.3",
    "react-dnd-html5-backend": "^11.1.3",
    "react-icons": "^4.2.0"
  },
  "peerDependencies": {
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  }
}
