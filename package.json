{
  "version": "0.7.2",
  "description": "OSMstudios own React component library",
  "author": "Dawson Goodell <dawsong@osmstudios.com>",
  "workspaces": {
    "packages": [
      "packages/*",
      "website"
    ],
    "nohoist": [
      "@emotion/react/types",
      "**/@emotion/react/types",
      "**/@types/theme-ui",
      "**/@types/theme-ui/**",
      "**/@types/theme-ui__components",
      "vite"
    ]
  },
  "files": [
    "dist"
  ],
  "repository": "https://github.com/DawsonG/maelstrom-futurism",
  "license": "MIT",
  "scripts": {
    "build": "lerna run build --ignore src,website --stream",
    "test": "lerna run test --ignore src,website --no-private --stream",
    "clean": "lerna run clean --ignore src,website --no-private --stream && rm -Rf node_modules && rm package-lock.json",
    "bootstrap": "lerna bootstrap",
    "prepublishOnly": "npm run build",
    "create-documentation-website": "cd ./website && npm run build",
    "publish": "lerna publish"
  },
  "devDependencies": {
    "@parcel/config-default": "^2.14.4",
    "@parcel/packager-ts": "^2.14.4",
    "@parcel/transformer-inline-string": "^2.14.4",
    "@parcel/transformer-sass": "^2.14.4",
    "@parcel/transformer-typescript-types": "^2.14.4",
    "@svgr/plugin-svgo": "^8.1.0",
    "@testing-library/react": "^13.4.0",
    "@vitejs/plugin-react-swc": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "commander": "^13.1.0",
    "cross-env": "^7.0.3",
    "lerna": "^8.1.8",
    "parcel": "^2.14.4",
    "polished": "^4.3.1",
    "type-fest": "^4.39.1",
    "typescript": "^5.8.2",
    "vite": "^7.2.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-sass-dts": "^1.3.34",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">= 18",
    "react-dom": ">= 18"
  }
}
