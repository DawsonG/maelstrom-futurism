{
    "include": ["src"],
    "compilerOptions": {
        "target": "es2020",
        "module": "esnext",
        "outDir": "dist",
        "declaration": true,
        "declarationDir": "dist",
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "emitDeclarationOnly": true,
        "types": ["vite/client"]
    }
}