{
    "extends": "../../tsconfig.json",
    "include": ["src", "vite.config.ts"],
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Node",
        "allowSyntheticDefaultImports": true,
        "outDir": "dist",
        "jsxImportSource": "@emotion/react",
        "jsx": "react-jsx",
        "sourceMap": true,
        "declaration": true,
        "declarationDir": "dist"
    }
}