{
  "name": "@maelstrom-futurism/layout",
  "version": "1.0.0",
  "description": "Basic layout components of MF",
  "keywords": [
    "layout",
    "grid",
    "flexbox"
  ],
  "author": "Dawson Goodell <dawsong@osmstudios.com>",
  "homepage": "http://www.osmstudios.com",
  "license": "MIT",
  "main": "dist/layout/index.js",
  "module": "dist/layout/index.js",
  "types": "dist/layout/index.d.ts",
  "typings": "dist/layout/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DawsonG/maelstrom-futurism.git",
    "directory": "packages/layout"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "start": "nodemon --watch src --exec yarn build -e ts,tsx",
    "build": "concurrently npm:build:*",
    "test": "jest --env=jsdom --passWithNoTests",
    "lint": "concurrently yarn:lint:*",
    "version": "yarn build",
    "build:all": "tsc --outDir dist",
    "test:cov": "npm run test --coverage",
    "lint:src": "eslint src --ext .ts,.tsx --config ../../.eslintrc",
    "lint:types": "tsc --noEmit"
  },
  "bugs": {
    "url": "https://github.com/DawsonG/maelstrom-futurism/issues"
  },
  "devDependences": {
    "react": "17.0.2",
    "@emotion/react": "^11.1.4",
    "@maelstrom-futurism/theme": "0.7.0"
  },
  "peerDependences": {
    "@emotion/react": ">= 11",
    "react": ">= 17.0.2"
  },
  "devDependencies": {
    "@emotion/react": "^11.4.0",
    "@types/react": "^17.0.15",
    "concurrently": "^7.0.0",
    "react": "^17.0.2",
    "typescript": "^4.5.4"
  }
}
